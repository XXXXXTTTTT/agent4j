# Agent4J 本地 Docker Compose 配置
# 复制为 .env 后按需修改：Copy-Item .env.example .env

POSTGRES_DB=agent
POSTGRES_USER=agent
POSTGRES_PASSWORD=change-me-for-local-use
AGENT_WEB_PORT=8080
AGENT_LOG_HOST_DIR=./logs

# 默认开启 sample 图，容器启动后可直接通过 REST 验收。
AGENT_SAMPLE_ENABLED=true

# OpenAI 兼容模型网关。关闭时 Core 仍保持构造器注入模式。
AGENT_LLM_ENABLED=false
AGENT_LLM_BASE_URL=https://api.openai.com
AGENT_LLM_API_KEY=
AGENT_LLM_CHAT_COMPLETIONS_PATH=/v1/chat/completions
AGENT_LLM_CODE_MODEL=
AGENT_LLM_VISION_MODEL=
AGENT_LLM_QUICK_CLASSIFICATION_MODEL=
AGENT_LLM_FALLBACK_MODEL=

# 生产 Code Agent：启用后 Web 工作台默认提交 /api/runs/code-agent。
AGENT_PRODUCTION_ENABLED=false
# Docker Compose 挂载到 Agent 的宿主 Git 工作区；宿主直接运行 agent-web 时不使用此项。
AGENT_CODE_HOST_WORKSPACE=.
AGENT_CODE_WORKSPACE=.
AGENT_CODE_REPOSITORY_ID=local
AGENT_CODE_USER_ID=local
AGENT_CODE_REVIEWER_URL=
AGENT_CODE_EXECUTION_MODE=DOCKER
AGENT_CODE_BASH_EXECUTABLE=/bin/bash
AGENT_CODE_DOCKER_IMAGE=maven:3.9.9-eclipse-temurin-21
AGENT_CODE_CONTAINER_WORKSPACE=/workspace
# 宿主直接运行 agent-web 时保持为空；Compose 会按服务名精确覆盖这两个值。
AGENT_CODE_WORKSPACE_SOURCE_CONTAINER=
AGENT_CODE_WORKSPACE_SOURCE_PATH=
AGENT_CODE_COMMAND_TIMEOUT=10m
AGENT_CODE_BROWSER_TIMEOUT=30s
AGENT_CODE_SNAPSHOT_MAX_FILES=200
AGENT_CODE_SNAPSHOT_MAX_BYTES=524288
AGENT_CODE_MAX_REPAIR_ATTEMPTS=2
AGENT_CODE_MAX_STEPS=12
AGENT_CODE_MAX_DURATION_MS=1800000
AGENT_CODE_IDLE_TIMEOUT_MS=120000
AGENT_CODE_TOKEN_BUDGET=200000
AGENT_CODE_NO_PROGRESS_LIMIT=3
AGENT_CODE_PLANNER_CONTEXT_MAX_TOKENS=12000

# OpenTelemetry/Langfuse OTLP 导出，默认关闭。
AGENT_OBSERVABILITY_ENABLED=false
AGENT_OBSERVABILITY_SERVICE_NAME=agent-runtime-system
AGENT_OBSERVABILITY_OTLP_TRACES_ENDPOINT=
AGENT_OBSERVABILITY_AUTHORIZATION=
AGENT_OBSERVABILITY_EXPORT_TIMEOUT=10s
